PORT=3000
NODE_ENV="development"  # development | production
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
CORS_ORIGIN="*"
LOG_LEVEL="info"  # debug | info | warn | error

# Ollama (LLM backend for SSE streaming)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3.5:2b"
OLLAMA_SYSTEM_PROMPT="You are a helpful assistant. When you think before answering: pick one approach immediately, state it in 1-3 short bullets, then stop. Never revisit or rephrase the same point twice. Never list alternatives. Go straight to the answer."
OLLAMA_THINK="true"  # true | false
MAX_HISTORY_MESSAGES="20"

# Memory Distillation
DISTILLATION_SERVICE_URL="https://memory.pik8s.internal"
DISTILLATION_ENABLED="false"
DISTILLATION_TIMEOUT_MS="120000"
DISTILLATION_MIN_MESSAGES="10"
DISTILLATION_MIN_INTERVAL_MS="900000"
DISTILLATION_MAX_MESSAGES="50"
ALLOW_SELF_SIGNED_CERTS="false"

# Instruction Services (GAP 4 — global+org instructions from admin, personal from portal)
ADMIN_API_URL="http://admin-api-chart.default.svc.cluster.local:80"
PORTAL_API_URL="http://portal-api-chart.default.svc.cluster.local:80"

# Memory Retrieval (read path — inject relevant memories into each LLM prompt)
MEMORY_SERVICE_URL="https://memory.pik8s.internal"
MEMORY_SERVICE_ENABLED="true"
MEMORY_SEARCH_LIMIT="10"